{
  "name": "spacetimehackathon-quality-gates",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint:actions": "node scripts/lint-actions-local.mjs",
    "lint:markdown": "node scripts/lint-markdown-local.mjs",
    "scan:secrets": "node scripts/scan-secrets-local.mjs",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "test:contracts": "node scripts/test-contracts.mjs",
    "ci:quality": "npm run lint:actions && npm run lint:markdown && npm run scan:secrets && npm run audit:dependencies && npm run test:contracts"
  }
}
