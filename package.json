{
  "name": "solar-dominion",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "orchestrator"
  ],
  "scripts": {
    "test": "npm run test:runner && npm run test --workspaces --if-present",
    "test:runner": "node --test scripts/local-demo-runner.test.mjs",
    "build": "npm run build --workspaces --if-present",
    "demo": "node scripts/local-demo-runner.mjs",
    "demo:smoke": "node scripts/local-demo-runner.mjs --smoke",
    "dev:client": "npm run dev --workspace=client",
    "dev:orchestrator": "npm run dev --workspace=orchestrator",
    "spacetime:build": "npm run spacetime:build --workspace=server",
    "spacetime:start": "npm run spacetime:start --workspace=server",
    "spacetime:publish": "npm run spacetime:publish --workspace=server",
    "generate": "npm run generate --workspace=server"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
