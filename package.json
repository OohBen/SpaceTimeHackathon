{
  "name": "solar-dominion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client",
    "orchestrator"
  ],
  "scripts": {
    "test": "npm run test:presentation-artifacts && npm run test:presentation-smoke && npm run test:runner && npm run test --workspaces --if-present && npm run ci:quality",
    "test:presentation-artifacts": "node --test scripts/presentation-artifacts.test.mjs",
    "test:presentation-smoke": "node --test scripts/presentation-smoke.test.mjs",
    "test:runner": "node --test scripts/local-demo-runner.test.mjs",
    "build": "npm run build --workspaces --if-present",
    "demo": "node scripts/local-demo-runner.mjs",
    "demo:presentation-smoke": "node scripts/presentation-smoke.mjs",
    "demo:smoke": "node scripts/local-demo-runner.mjs --smoke",
    "dev:client": "npm run dev --workspace=client",
    "dev:orchestrator": "npm run dev --workspace=orchestrator",
    "test:browser:mock": "npm run test --workspace=client -- src/routes/expandedBrowserE2E.test.tsx --testNamePattern mock",
    "test:browser:fixture": "npm run test --workspace=client -- src/routes/expandedBrowserE2E.test.tsx --testNamePattern fixture",
    "spacetime:build": "npm run spacetime:build --workspace=server",
    "spacetime:start": "npm run spacetime:start --workspace=server",
    "spacetime:publish": "npm run spacetime:publish --workspace=server",
    "generate": "npm run generate --workspace=server",
    "lint:actions": "node scripts/lint-actions-local.mjs",
    "lint:markdown": "node scripts/lint-markdown-local.mjs",
    "scan:secrets": "node scripts/scan-secrets-local.mjs",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "test:contracts": "node scripts/test-contracts.mjs",
    "test:hosted-smoke": "node --test scripts/hosted-smoke.test.mjs",
    "smoke:hosted": "node scripts/hosted-smoke.mjs",
    "ci:quality": "npm run lint:actions && npm run lint:markdown && npm run scan:secrets && npm run audit:dependencies && npm run test:contracts && npm run test:hosted-smoke"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
