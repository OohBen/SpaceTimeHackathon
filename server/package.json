{
  "name": "@solar-dominion/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build": "tsc --noEmit",
    "spacetime:build": "spacetime build",
    "spacetime:start": "spacetime start --db-name solar-dominion --anonymous-access",
    "spacetime:publish": "spacetime publish --db-name solar-dominion --anonymous-access",
    "generate": "spacetime generate --lang typescript --out-dir ../client/src/module_bindings"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "spacetimedb": "^2.4.1"
  }
}
