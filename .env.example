# ── LLM / OpenRouter ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inception/mercury-2

# live | mock | fixture
LLM_MODE=fixture

# ── SpacetimeDB ───────────────────────────────────────────────────────────────
SPACETIME_HOST=http://localhost:3000
SPACETIME_LISTEN_ADDR=0.0.0.0:3000
SPACETIME_DB_NAME=solar-dominion

# ── Orchestrator HTTP ─────────────────────────────────────────────────────────
PORT=8787

# ── CORS (hosted deployment only) ────────────────────────────────────────────
# Vercel /health uses FRONTEND_ORIGIN, LLM_MODE, SPACETIME_HOST, and SPACETIME_DB_NAME.
FRONTEND_ORIGIN=http://localhost:5173

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_HOSTED=false
VITE_HOSTED_FRONTEND_URL=http://localhost:5173
VITE_SPACETIME_HOST=ws://localhost:3000
VITE_SPACETIME_DB_NAME=solar-dominion
VITE_ORCHESTRATOR_BASE_URL=http://localhost:8787
VITE_DEMO_MODE=fixture
VITE_LLM_MODE=fixture
VITE_SPACETIMEDB_URI=http://localhost:3000
VITE_SPACETIMEDB_MODULE=solar-dominion
