{
  "name": "@solar-dominion/orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "worker": "tsx src/worker.ts",
    "generate": "spacetime generate --lang typescript --module-path ../server --out-dir ./src/module_bindings --yes",
    "build": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "spacetimedb": "^2.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  }
}
