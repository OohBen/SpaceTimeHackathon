# ── Secrets ────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Claude Code — generated files (run make-claude-md.sh after cloning) ────
# These are built locally from skills/*.md and AGENTS.md.
# Never commit generated harness artifacts — CRLF/LF differences between
# Windows and Mac teammates cause conflicts even on identical source.
CLAUDE.md
.claude/
AIDER.md
CODEX.md
ANTIGRAVITY.md
GEMINI.md

# ── Other harness directories ───────────────────────────────────────────────
# Each harness generates its own config directory. Keep those local.
# If you use a harness not listed here, add its directory to this section.
.cursor/
.aider*
.continue/
.copilot/
.windsurf/
.codex/
.gemini/

# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

